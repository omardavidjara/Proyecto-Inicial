{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/claude-check.mjs\"",
            "asyncRewake": true,
            "timeout": 300,
            "statusMessage": "npm run check"
          }
        ]
      }
    ]
  }
}
