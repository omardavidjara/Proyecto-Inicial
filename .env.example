# Copia este archivo como .env.local y rellena los valores (nunca subas .env.local).
# Neon → proyecto → Connect. Región: AWS Frankfurt (aws-eu-central-1), LIMITS D3.

# Con pooling (host con "-pooler"): la usa la app en Vercel y en local
DATABASE_URL=
# Directa (sin "-pooler"): solo para migraciones con drizzle-kit
DATABASE_URL_UNPOOLED=

# Neon Auth (consola → Auth → URL del servicio, termina en /neondb/auth)
NEON_AUTH_BASE_URL=
# Firma las cookies de sesión, mínimo 32 caracteres. Genéralo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Uno distinto por entorno (local, preview, producción)
NEON_AUTH_COOKIE_SECRET=

# Sentry (lib/sentry.ts). Solo en Vercel, entorno Production: en local no se envía nada.
# DSN: Sentry → Settings → Projects → athlos-app → Client Keys (DSN). No es secreto (va en la web)
NEXT_PUBLIC_SENTRY_DSN=
# Opcional, para ver el código original en los errores (subida de source maps al construir).
# El token sí es secreto: Sentry → Settings → Auth Tokens
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Vercel Blob (fotos de perfil, F1). Vercel lo añade solo al conectar el almacén (región fra1) al proyecto.
# En local: Vercel → Storage → el almacén → .env.local → copiar BLOB_READ_WRITE_TOKEN. Es secreto
BLOB_READ_WRITE_TOKEN=

# Eliminar cuentas en Neon Auth (F1, lib/neon-admin.ts). Solo en Production de Vercel, NUNCA en Preview (las previews
# copian la base de datos con los mismos ids de usuario y borrarían cuentas reales). Clave de organización limitada al
# proyecto: Neon → Organización → API keys → con proyecto. Es secreta
NEON_API_KEY=
NEON_PROJECT_ID=
# Rama de producción (la de Neon Auth): Neon → Branches → production → id
NEON_AUTH_BRANCH_ID=

# Tareas programadas (F3, app/api/cron/*). Vercel Cron la envía como `Authorization: Bearer …`. Solo en Production de
# Vercel (el cron solo se ejecuta ahí). Un valor aleatorio largo, p. ej. `openssl rand -hex 32`. Es secreta
CRON_SECRET=

# Avisos push (F10). Claves VAPID distintas en Production y en Preview: generarlas con
# `npx web-push generate-vapid-keys`. VAPID_SUBJECT: mailto: de contacto para los servicios de push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
